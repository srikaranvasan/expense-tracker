# Test environment. Integration tests replace MONGODB_URI with an ephemeral
# in-memory replica set, so the value here is only a placeholder.
NODE_ENV=test

MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=expense_tracker_test

AUTH_SECRET=test-secret-test-secret-test-secret-0000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

LOG_LEVEL=error

RATE_LIMIT_ENABLED=false
