# ---------------------------------------------------------------------------
# Expense Tracker - environment configuration
#
# Copy to `.env.local` for development. Never commit real secrets.
# Every variable here is validated at startup by src/config/env.ts.
#
# Use `.env.local` and nothing else. Next loads it last, so it wins over `.env`, and
# keeping both means half your future edits land in the file that is being overridden.
# `scripts/create-indexes.ts` reads `.env.local` only.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# --- Database --------------------------------------------------------------
# MongoDB connection string. Transactions require a replica set, so use a local
# replica set or MongoDB Atlas. A standalone mongod cannot run multi-document
# transactions (see docs/09-DATABASE-SCHEMA.md section 32).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=expense_tracker_dev

# --- Authentication --------------------------------------------------------
# Generate with: npx auth secret   (or)   openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-random-string
# Must match the port the app is served on. `npm run dev` uses 4000.
AUTH_URL=http://localhost:4000
# Set to true only when serving over HTTPS (production).
AUTH_TRUST_HOST=true

# --- Application defaults --------------------------------------------------
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Observability ---------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug

# --- Rate limiting ---------------------------------------------------------
# Set to false only to load-test or to run a suite that hammers an endpoint. A
# misconfigured value resolves to enabled, so a typo cannot leave sign-in unprotected.
RATE_LIMIT_ENABLED=true
